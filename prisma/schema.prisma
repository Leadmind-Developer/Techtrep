generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String                  @id @default(cuid())
  name                           String?
  email                          String                  @unique
  passwordHash                   String
  role                           UserRole                @default(STAFF)
  active                         Boolean                 @default(true)
  lastLoginAt                    DateTime?
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  createdActivities              Activity[]              @relation("ActivityCreatedBy")
  auditLogs                      AuditLog[]
  leadAssignmentsCreated         LeadAssignment[]        @relation("LeadAssignmentAssignedBy")
  leadAssignmentsReceived        LeadAssignment[]        @relation("LeadAssignmentAssignedTo")
  assignedLeads                  Lead[]                  @relation("LeadAssignedTo")
  createdLeads                   Lead[]                  @relation("LeadCreatedBy")
  assignedOpportunities          Opportunity[]           @relation("OpportunityAssignedTo")
  createdOpportunities           Opportunity[]           @relation("OpportunityCreatedBy")
  opportunityAssignmentsCreated  OpportunityAssignment[] @relation("OpportunityAssignmentAssignedBy")
  opportunityAssignmentsReceived OpportunityAssignment[] @relation("OpportunityAssignmentAssignedTo")
  createdProposals               Proposal[]              @relation("ProposalCreatedBy")
  projectManagerProjects         Project[]               @relation("ProjectManager")
  createdProjects                Project[]               @relation("ProjectCreatedBy")
  createdPayments                Payment[]               @relation("PaymentCreatedBy")
  managedServices                ManagedService[]        @relation("ManagedServiceManager")
  serviceRequestsAssigned        ServiceRequest[]        @relation("ServiceRequestAssignee")
  preparedServiceReports         ServiceReport[]         @relation("ServiceReportPreparer")
  sessions                       Session[]

  @@index([role])
  @@index([active])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  website         String?
  industry        String?
  companySize     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activities      Activity[]
  audits          AuditRequest[]
  contacts        Contact[]
  leads           Lead[]
  managedServices ManagedService[]
  serviceRequests ServiceRequest[]
  serviceReports  ServiceReport[]

  @@index([name])
  @@index([industry])
  @@map("organizations")
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  role           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  audits         AuditRequest[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@index([organizationId])
  @@index([email])
  @@map("contacts")
}

model Lead {
  id               String           @id @default(cuid())
  organizationId   String
  contactId        String?
  status           LeadStatus       @default(NEW)
  source           LeadSource       @default(WEBSITE)
  notes            String?
  estimatedValue   Decimal?         @db.Decimal(15, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignedToUserId String?
  createdByUserId  String?
  activities       Activity[]
  auditRequests    AuditRequest[]
  assignments      LeadAssignment[]
  assignedToUser   User?            @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id])
  contact          Contact?         @relation(fields: [contactId], references: [id])
  createdByUser    User?            @relation("LeadCreatedBy", fields: [createdByUserId], references: [id])
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contactId])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("leads")
}

model LeadAssignment {
  id               String    @id @default(cuid())
  leadId           String    @unique(map: "lead_assignments_one_active", where: raw("(\"unassignedAt\" IS NULL)"))
  assignedToUserId String
  assignedByUserId String?
  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?
  createdAt        DateTime  @default(now())
  assignedByUser   User?     @relation("LeadAssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  assignedToUser   User      @relation("LeadAssignmentAssignedTo", fields: [assignedToUserId], references: [id])
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([assignedToUserId])
  @@index([assignedByUserId])
  @@index([assignedAt])
  @@index([unassignedAt])
  @@map("lead_assignments")
}

model AuditRequest {
  id                    String        @id @default(cuid())
  organizationId        String
  contactId             String
  leadId                String?
  improvements          String[]
  manualWork            String
  existingSystems       String?
  additionalInformation String?
  status                AuditStatus   @default(REQUESTED)
  source                LeadSource    @default(AUDIT)
  scheduledAt           DateTime?
  completedAt           DateTime?
  reportSentAt          DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  activities            Activity[]
  contact               Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead                  Lead?         @relation(fields: [leadId], references: [id])
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities         Opportunity[]

  @@index([organizationId])
  @@index([contactId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  @@map("audit_requests")
}

model Opportunity {
  id               String                  @id @default(cuid())
  auditRequestId   String
  name             String
  description      String?
  priority         OpportunityPriority     @default(MEDIUM)
  status           OpportunityStatus       @default(IDENTIFIED)
  estimatedValue   Decimal?                @db.Decimal(15, 2)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  assignedToUserId String?
  closedAt         DateTime?
  createdByUserId  String?
  assignedToUser   User?                   @relation("OpportunityAssignedTo", fields: [assignedToUserId], references: [id])
  auditRequest     AuditRequest            @relation(fields: [auditRequestId], references: [id], onDelete: Cascade)
  createdByUser    User?                   @relation("OpportunityCreatedBy", fields: [createdByUserId], references: [id])
  assignments      OpportunityAssignment[]
  proposals        Proposal[]

  @@index([auditRequestId])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
  @@index([closedAt])
  @@map("opportunities")
}

model OpportunityAssignment {
  id               String      @id @default(cuid())
  opportunityId    String      @unique(map: "opportunity_assignments_one_active", where: raw("(\"unassignedAt\" IS NULL)"))
  assignedToUserId String
  assignedByUserId String?
  assignedAt       DateTime    @default(now())
  unassignedAt     DateTime?
  createdAt        DateTime    @default(now())
  assignedByUser   User?       @relation("OpportunityAssignmentAssignedBy", fields: [assignedByUserId], references: [id])
  assignedToUser   User        @relation("OpportunityAssignmentAssignedTo", fields: [assignedToUserId], references: [id])
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([assignedToUserId])
  @@index([assignedByUserId])
  @@index([assignedAt])
  @@index([unassignedAt])
  @@map("opportunity_assignments")
}

model Proposal {
  id              String  @id @default(cuid())
  opportunityId   String
  createdByUserId String?

  proposalNumber String  @unique
  title          String
  description    String?

  amount   Decimal?       @db.Decimal(15, 2)
  currency String         @default("NGN")
  status   ProposalStatus @default(DRAFT)

  validUntil DateTime?

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  notes String?

  publicToken          String?   @unique
  publicTokenCreatedAt DateTime?

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdByUser User?       @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project?
  contract  Contract?

  @@index([opportunityId])
  @@index([createdByUserId])
  @@index([status])
  @@index([validUntil])
  @@index([createdAt])
  @@map("proposals")
}

model Contract {
  id             String         @id @default(cuid())
  proposalId     String         @unique
  contractNumber String         @unique
  title          String
  description    String?
  status         ContractStatus @default(DRAFT)
  amount         Decimal?       @db.Decimal(15, 2)
  currency       String         @default("NGN")
  startDate      DateTime?
  endDate        DateTime?
  signedAt       DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  proposal        Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  managedServices ManagedService[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
  @@map("contracts")
}

model Invoice {
  id               String  @id @default(cuid())
  contractId       String
  managedServiceId String?
  invoiceNumber    String  @unique

  title       String
  description String?

  amount   Decimal @db.Decimal(15, 2)
  currency String  @default("NGN")

  status InvoiceStatus @default(DRAFT)

  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract       Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  managedService ManagedService? @relation(fields: [managedServiceId], references: [id], onDelete: SetNull)

  payments Payment[]

  @@unique([managedServiceId, billingPeriodStart])
  @@index([contractId])
  @@index([managedServiceId])
  @@index([status])
  @@index([issuedAt])
  @@index([dueDate])
  @@index([billingPeriodStart])
  @@index([createdAt])
  @@map("invoices")
}

model Payment {
  id            String @id @default(cuid())
  invoiceId     String
  paymentNumber String @unique

  amount   Decimal @db.Decimal(15, 2)
  currency String  @default("NGN")

  method PaymentMethod
  status PaymentStatus @default(COMPLETED)

  paidAt DateTime @default(now())

  reference String?
  notes     String?

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  receipt       Receipt?

  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
  @@index([reference])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("payments")
}

model Receipt {
  id            String @id @default(cuid())
  paymentId     String @unique
  receiptNumber String @unique

  issuedAt DateTime @default(now())

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@map("receipts")
}

model Project {
  id         String @id @default(cuid())
  proposalId String @unique

  projectNumber String  @unique
  name          String
  description   String?

  status   ProjectStatus       @default(PLANNING)
  priority OpportunityPriority @default(MEDIUM)

  contractValue Decimal? @db.Decimal(15, 2)
  currency      String   @default("NGN")

  startDate     DateTime?
  targetEndDate DateTime?
  completedAt   DateTime?

  projectManagerId String?
  createdByUserId  String?

  proposal       Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  projectManager User?    @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  createdByUser  User?    @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  managedServices ManagedService[]

  @@index([projectManagerId])
  @@index([createdByUserId])
  @@index([status])
  @@index([priority])
  @@index([startDate])
  @@index([targetEndDate])
  @@index([createdAt])
  @@map("projects")
}

model ManagedService {
  id String @id @default(cuid())

  organizationId String
  projectId      String?
  contractId     String?

  serviceNumber String  @unique
  name          String
  description   String?

  type   ManagedServiceType
  status ManagedServiceStatus @default(DRAFT)
  sla    ManagedServiceSla    @default(STANDARD)

  recurringFee Decimal? @db.Decimal(15, 2)
  currency     String   @default("NGN")

  billingFrequency ManagedServiceBillingFrequency @default(MONTHLY)
  billingEnabled   Boolean                        @default(false)
  nextBillingDate  DateTime?

  startDate DateTime?
  endDate   DateTime?

  serviceManagerId String?
  notes            String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract       Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  serviceManager User?        @relation("ManagedServiceManager", fields: [serviceManagerId], references: [id], onDelete: SetNull)

  serviceRequests ServiceRequest[]
  invoices        Invoice[]
  serviceReports  ServiceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([contractId])
  @@index([type])
  @@index([status])
  @@index([serviceManagerId])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
  @@index([nextBillingDate])
  @@map("managed_services")
}

model ServiceRequest {
  id String @id @default(cuid())

  managedServiceId String
  organizationId   String

  requestNumber String @unique

  title       String
  description String?

  status   ServiceRequestStatus   @default(OPEN)
  priority ServiceRequestPriority @default(NORMAL)

  assignedToId String?

  openedAt           DateTime  @default(now())
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  assignedAt         DateTime?
  startedAt          DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?

  resolution String?
  notes      String?

  managedService ManagedService @relation(fields: [managedServiceId], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedTo User? @relation("ServiceRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managedServiceId])
  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([openedAt])
  @@index([createdAt])
  @@map("service_requests")
}

model ServiceReport {
  id String @id @default(cuid())

  organizationId   String
  managedServiceId String
  preparedById     String?

  reportNumber String @unique

  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  reportDate           DateTime @default(now())

  status      ServiceReportStatus @default(DRAFT)
  finalizedAt DateTime?

  publicTokenHash      String?   @unique
  publicTokenExpiresAt DateTime?
  publicTokenRevokedAt DateTime?

  // Narrative sections
  executiveSummary String? @db.Text
  workPerformed    String? @db.Text
  incidentSummary  String? @db.Text
  recommendations  String? @db.Text
  nextSteps        String? @db.Text

  // Snapshot of service-request activity
  totalRequests    Int @default(0)
  resolvedRequests Int @default(0)
  openRequests     Int @default(0)
  urgentRequests   Int @default(0)

  slaEligibleRequests Int      @default(0)
  slaMetRequests      Int      @default(0)
  slaBreachedRequests Int      @default(0)
  slaComplianceRate   Decimal? @db.Decimal(5, 2)

  // Snapshot of billing figures; informational only
  billingCurrency  String  @default("NGN")
  totalInvoiced    Decimal @default(0) @db.Decimal(15, 2)
  totalPaid        Decimal @default(0) @db.Decimal(15, 2)
  totalOutstanding Decimal @default(0) @db.Decimal(15, 2)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managedService ManagedService @relation(fields: [managedServiceId], references: [id], onDelete: Cascade)
  preparedBy     User?          @relation("ServiceReportPreparer", fields: [preparedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([managedServiceId, reportingPeriodStart, reportingPeriodEnd])
  @@index([organizationId, reportDate])
  @@index([managedServiceId, reportingPeriodStart])
  @@index([status])
  @@index([preparedById])
  @@map("service_reports")
}

model Activity {
  id              String        @id @default(cuid())
  organizationId  String
  leadId          String?
  auditRequestId  String?
  type            ActivityType
  description     String
  metadata        Json?
  createdAt       DateTime      @default(now())
  createdByUserId String?
  auditRequest    AuditRequest? @relation(fields: [auditRequestId], references: [id])
  createdByUser   User?         @relation("ActivityCreatedBy", fields: [createdByUserId], references: [id])
  lead            Lead?         @relation(fields: [leadId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([auditRequestId])
  @@index([createdByUserId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  requestId String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISCOVERY
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  AUDIT
  REFERRAL
  WHATSAPP
  EMAIL
  PHONE
  LINKEDIN
  SOCIAL_MEDIA
  DIRECT
  OTHER
}

enum AuditStatus {
  REQUESTED
  CONTACTED
  SCHEDULED
  COMPLETED
  REPORT_SENT
  PROPOSAL_SENT
  WON
  LOST
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OpportunityStatus {
  IDENTIFIED
  DISCUSSED
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  DECLINED
  WON
  LOST
}

enum ActivityType {
  NOTE
  EMAIL
  PHONE_CALL
  WHATSAPP
  MEETING
  AUDIT
  PROPOSAL
  FOLLOW_UP
  STATUS_CHANGE
  OTHER
}

enum UserRole {
  ADMIN
  STAFF
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_EXPIRED
  DISABLED_ACCOUNT
  USER_CREATED
  USER_UPDATED
  USER_DISABLED
  USER_ENABLED
  PASSWORD_CHANGED
  PASSWORD_RESET
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  POS
  USSD
  MOBILE_MONEY
  CHEQUE
  OTHER
}

enum PaymentStatus {
  COMPLETED
  VOID
  REFUNDED
}

enum ManagedServiceType {
  MANAGED_IT
  CLOUD
  SOFTWARE_SUPPORT
  AI_SUPPORT
  WEBSITE
  NETWORK
  INFRASTRUCTURE
  CUSTOM
}

enum ManagedServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum ManagedServiceSla {
  BASIC
  STANDARD
  PRIORITY
  PREMIUM
}

enum ManagedServiceBillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum ServiceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
  CANCELLED
}

enum ServiceRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceReportStatus {
  DRAFT
  FINALIZED
}
